#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";

        ctrlc {
            bindings = <&kp LC(C)>;
            key-positions = <14 15>;
        };

        ctrlv {
            bindings = <&kp LC(V)>;
            key-positions = <15 16>;
        };

        left {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 3>;
        };

        rg {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <3 17>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <14 28>;
        };

        til {
            bindings = <&kp TILDE>;
            key-positions = <13 14>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB                 &kp Q  &kp W  &kp E           &kp R               &kp T                           &kp UP                &kp Y        &kp U        &kp I      &kp O    &kp P          &kp ESC
&mt CAPSLOCK BACKSPACE  &kp A  &kp S  &kp D           &kp F               &kp G                 &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &kp J        &kp K      &kp L    &kp SEMICOLON  &kp SQT
&kp LCTRL               &kp Z  &kp X  &kp C           &kp V               &kp B        &kp A              &kp DOWN              &kp N        &kp M        &kp COMMA  &kp DOT  &kp KP_DOT     &kp SLASH
                                      &lt 2 LEFT_GUI  &mt RSHFT KP_ENTER  &lt 3 ENTER                                           &lt 3 ENTER  &lt 1 SPACE  &kp RALT
            >;

            sensor-bindings = <&none>, <&none>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans        &kp N1        &kp N2        &kp N3        &kp N4        &kp N5                                      &mmv MOVE_UP                     &kp N6           &kp N7           &kp UP_ARROW     &kp DEL          &kp HOME  &kp PAGE_UP
&kp CAPS      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                      &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT         &kp LEFT_ARROW   &kp DOWN         &kp RIGHT        &kp END   &kp PAGE_DOWN
&bt BT_SEL 2  &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0        &kp C_MUTE                    &mmv MOVE_DOWN                   &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp END   &kp PG_DN
                                          &trans        &bt BT_SEL 2  &bt BT_SEL 0                                                                 &kp INS          &kp DEL          &trans
            >;

            sensor-bindings = <&none>, <&none>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL   &kp AT         &kp HASH          &kp DLLR              &kp PRCNT                                        &mmv MOVE_UP                     &kp CARET  &kp NUMBER_7  &kp N8        &kp NUMBER_9  &kp MINUS  &kp BSPC
&trans  &kp CARET  &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS   &kp GRAVE
&trans  &kp MINUS  &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &mkp MB5               &trans                    &mmv MOVE_DOWN                   &kp UNDER  &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &kp TILDE
                                  &trans            &trans                &kp SPACE                                                                         &kp RET    &trans        &kp N0
            >;

            sensor-bindings = <&none>, <&none>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&studio_unlock  &kp F1            &kp F2            &kp F3            &kp F4            &kp F5                                          &mmv MOVE_UP                     &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&trans          &kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &kp LC(NUMBER_4)  &kp LC(NUMBER_5)                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&trans          &sys_reset        &trans            &bootloader       &trans            &mkp MB5          &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                                    &trans            &trans            &trans                                                                           &trans       &trans     &trans
            >;

            sensor-bindings = <&none>, <&none>;
        };
    };
};
